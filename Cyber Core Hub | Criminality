local function drawESP(p)
    if p == player then return end
    local safeGui = game:GetService("CoreGui"):FindFirstChild("CyberEspContainer")
    if not safeGui then
        safeGui = Instance.new("ScreenGui")
        safeGui.Name = "CyberEspContainer"
        safeGui.Parent = game:GetService("CoreGui")
        safeGui.ResetOnSpawn = false
    end
    local infoLabel = Instance.new("TextLabel", safeGui)
    infoLabel.BackgroundTransparency = 1; infoLabel.TextSize = 12; infoLabel.Font = Enum.Font.Code; infoLabel.TextStrokeTransparency = 0.2; infoLabel.Visible = false

    task.spawn(function()
        while p and p.Parent and infoLabel.Parent do
            if _G.AdvancedESP then
                local char = p.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                        infoLabel.Position = UDim2.new(0, pos.X - 100, 0, pos.Y - 40); infoLabel.Size = UDim2.new(0, 200, 0, 15)
                        infoLabel.Text = string.format("%s [%dm] - HP: %d", string.upper(p.Name), math.floor(dist), math.floor(hum.Health))
                        infoLabel.TextColor3 = hum.Health > 50 and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(255, 60, 60)
                        infoLabel.Visible = true
                    else infoLabel.Visible = false end
                else infoLabel.Visible = false end
            else
                infoLabel.Visible = false
            end
            task.wait(0.03)
        end
        infoLabel:Destroy()
    end)
end

_G.StartESP_Global = function()
    local oldGui = game:GetService("CoreGui"):FindFirstChild("CyberEspContainer")
    if oldGui then oldGui:Destroy() end
    if _G.AdvancedESP then
        for _, p in pairs(game:GetService("Players"):GetPlayers()) do drawESP(p) end
    end
end

