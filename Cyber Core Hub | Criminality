local function CreateToggle(name, globalVarName, parentPage, callback)
    local Button = Instance.new("TextButton", parentPage)
    Button.Size = UDim2.new(1, -10, 0, 35); Button.BackgroundColor3 = Color3.fromRGB(22, 24, 33); Button.Font = Enum.Font.Gotham; Button.TextSize = 13; Button.BorderSizePixel = 0; Button.AutoButtonColor = false
    Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 6)
    
    local function updateVisual()
        local state = _G[globalVarName]
        Button.Text = "  " .. name .. (state and " : [ ВКЛ ]" or " : [ ВЫКЛ ]")
        Button.TextColor3 = state and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(160, 165, 175)
    end
    Button.MouseButton1Click:Connect(function()
        _G[globalVarName] = not _G[globalVarName]
        updateVisual()
        if callback then callback(_G[globalVarName]) end
    end)
    updateVisual()
end

local function CreateSlider(name, min, max, default, parentPage, callback)
    local SliderFrame = Instance.new("Frame", parentPage)
    SliderFrame.Size = UDim2.new(1, -10, 0, 45); SliderFrame.BackgroundColor3 = Color3.fromRGB(22, 24, 33); SliderFrame.BorderSizePixel = 0
    Instance.new("UICorner", SliderFrame).CornerRadius = UDim.new(0, 6)
    
    local SliderLabel = Instance.new("TextLabel", SliderFrame)
    SliderLabel.Size = UDim2.new(1, -10, 0, 20); SliderLabel.Position = UDim2.new(0, 8, 0, 2); SliderLabel.BackgroundTransparency = 1; SliderLabel.Font = Enum.Font.Gotham; SliderLabel.TextSize = 12; SliderLabel.TextColor3 = Color3.fromRGB(180, 185, 195); SliderLabel.TextXAlignment = Enum.TextXAlignment.Left; SliderLabel.Text = name .. ": " .. default
    
    local BarBackground = Instance.new("Frame", SliderFrame)
    BarBackground.Size = UDim2.new(1, -20, 0, 4); BarBackground.Position = UDim2.new(0, 10, 0, 28); BarBackground.BackgroundColor3 = Color3.fromRGB(35, 38, 50); BarBackground.BorderSizePixel = 0
    Instance.new("UICorner", BarBackground).CornerRadius = UDim.new(1, 0)
    
    local BarMain = Instance.new("Frame", BarBackground)
    BarMain.Size = UDim2.new((default - min) / (max - min), 0, 1, 0); BarMain.BackgroundColor3 = Color3.fromRGB(0, 255, 170); BarMain.BorderSizePixel = 0
    Instance.new("UICorner", BarMain).CornerRadius = UDim.new(1, 0)
    
    local DragButton = Instance.new("TextButton", BarBackground)
    DragButton.Size = UDim2.new(0, 10, 0, 10); DragButton.Position = UDim2.new((default - min) / (max - min), -5, 0, -3); DragButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255); DragButton.Text = ""; DragButton.BorderSizePixel = 0
    Instance.new("UICorner", DragButton).CornerRadius = UDim.new(1, 0)
    
    local dragging = false
    local function updateSlider(input)
        local relativeX = math.clamp((input.Position.X - BarBackground.AbsolutePosition.X) / BarBackground.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + relativeX * (max - min))
        BarMain.Size = UDim2.new(relativeX, 0, 1, 0)
        DragButton.Position = UDim2.new(relativeX, -5, 0, -3)
        SliderLabel.Text = name .. ": " .. value
        callback(value)
    end
    
    DragButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then updateSlider(input) end
    end)
end

