local function applyObjectHighlight(obj, color, name, checkGlobalBool)
    if obj:FindFirstChild("CyberObjectESP") then return end
    
    local Highlight = Instance.new("Highlight")
    Highlight.Name = "CyberObjectESP"
    Highlight.FillColor = color
    Highlight.FillTransparency = 0.4
    Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    Highlight.OutlineTransparency = 0.1
    Highlight.Adornee = obj
    Highlight.Parent = obj

    local Billboard = Instance.new("BillboardGui", obj)
    Billboard.Name = "CyberObjectText"
    Billboard.Size = UDim2.new(0, 160, 0, 30)
    Billboard.AlwaysOnTop = true
    Billboard.StudsOffset = Vector3.new(0, 2, 0)
    
    local TextLabel = Instance.new("TextLabel", Billboard)
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextColor3 = color
    TextLabel.TextStrokeTransparency = 0
    TextLabel.TextSize = 11
    TextLabel.Font = Enum.Font.GothamBold
    
    task.spawn(function()
        while obj and obj.Parent and Highlight.Parent do
            if _G[checkGlobalBool] then
                Highlight.Enabled = true
                Billboard.Enabled = true
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local targetPos = obj:IsA("Model") and (obj.PrimaryPart and obj.PrimaryPart.Position or obj:FindFirstChildOfClass("BasePart").Position) or obj.Position
                    local dist = (hrp.Position - targetPos).Magnitude
                    TextLabel.Text = string.format("%s [%dm]", name, math.floor(dist))
                end
            else
                Highlight.Enabled = false
                Billboard.Enabled = false
            end
            task.wait(0.5)
        end
        Highlight:Destroy()
        Billboard:Destroy()
    end)
end

